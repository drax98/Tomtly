# Your config directory, holding config.json and automations/. Start from examples/.
TOMTLY_DIR=${HOME}/.config/tomtly

# Optional: a released image to run, like ghcr.io/drax98/tomtly:1.0. Blank builds it from this folder.
TOMTLY_IMAGE=

# 127.0.0.1 keeps the panel on this machine. Read the README before changing it: it needs HTTPS in front of it.
BIND_ADDRESS=127.0.0.1
PORT=8099

# The service keeps its state in Postgres. The password is put into a connection URL, so keep it to letters and digits.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts extension settings (keys, tokens, credential files) in the database. 64 hex characters: openssl rand -hex 32
# Keep a copy with your backups: a database restored without it has to have every extension's settings entered again.
TOMTLY_SECRET_KEY=

# Optional: the marketplace to browse, and the public key its list is signed with. Both blank means it isn't set up.
MARKETPLACE_URL=
MARKETPLACE_PUBLIC_KEY=
# The key approvals are signed with. Without it the Marketplace page refuses everything and says why.
MARKETPLACE_APPROVAL_PUBLIC_KEYS=
# The address or range of a reverse proxy in front of this (comma-separated). Its X-Forwarded-For is believed only from these.
TRUSTED_PROXIES=
